@prefix : <https://neverblink.eu/linkml/tests/library/> .
@prefix inst: <https://neverblink.eu/linkml/tests/instances/> .

inst:city-library a :Library ;
  :name "City library" ;
  :people inst:lem ;
  :books inst:solaris, inst:cyberiad .

inst:lem a :Person ;
  :name "Stanislaw Lem" ;
  :email "lem@example.org" .

inst:solaris a :Book ;
  :title "Solaris" ;
  :isbn "978-0156027601" ;
  :published_year 1961 ;
  :in_print true ;
  :tags "science fiction", "classic" ;
  :status :LoanStatus.ON_LOAN ;
  :author inst:lem ;
  :note [
    a :Note ;
    :text "Held for the reading group."
  ] .

inst:cyberiad a :Book ;
  :title "The Cyberiad" ;
  :in_print false ;
  :status :LoanStatus.AVAILABLE .
