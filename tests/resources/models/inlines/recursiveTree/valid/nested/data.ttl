@prefix : <https://neverblink.eu/linkml/tests/recursiveTree/> .
@base <https://neverblink.eu/linkml/tests/instances/> .

<root> a :Node;
  :id "root";
  :label "Root";
  :children <a>, <b> .

<a> a :Node;
  :id "a";
  :label "A";
  :parent <root>;
  :children <a1> .

<a1> a :Node;
  :id "a1";
  :label "A1";
  :parent <a> .

<b> a :Node;
  :id "b";
  :label "B";
  :parent <root> .
